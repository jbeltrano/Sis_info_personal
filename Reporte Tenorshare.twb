    <worksheet name='Nuevos clientes vs Meta'>
      <table>
        <view>
          <datasources>
            <datasource caption='ventas_techstore+' name='federated.1dg0os21k9auo81eipedq0hwrpvv' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Elege Año' datatype='string' datatype-customized='true' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Todos&quot;'>
              <calculation class='tableau' formula='&quot;Todos&quot;' />
            </column>
            <column caption='Elge mes' datatype='string' datatype-customized='true' name='[Parámetro 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Todos&quot;'>
