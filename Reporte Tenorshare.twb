      <column caption='Años Parametro' datatype='boolean' name='[Calculation_1216253428275777536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Todos&quot;&#13;&#10;THEN TRUE&#13;&#10;ELSE&#13;&#10;YEAR([fecha]) = INT([Parameters].[Parámetro 2])&#13;&#10;END' />
      </column>
      <column caption='Meses Parametro' datatype='boolean' name='[Calculation_1216253428276871169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3] = &quot;Todos&quot; THEN TRUE&#13;&#10;ELSE MONTH([fecha])= INT([Parameters].[Parámetro 3])&#13;&#10;END' />
      </column>
      <column caption='Meta_ventas' datatype='string' name='[Calculation_1295066421434331154]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([cantidad]*[precio_unitario]) &gt; SUM([meta_ventas])&#13;&#10;THEN &quot;Por encima de la meta&quot;&#13;&#10;ELSE &quot;Por debajo de la meta&quot;&#13;&#10;END' />
      </column>
      <column caption='Meta_productos' datatype='string' name='[Calculation_1295066421438128149]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF  SUM([cantidad]) &gt; SUM([meta_unidades])&#13;&#10;THEN &quot;Por encima de la meta&quot;&#13;&#10;ELSE &quot;Por debajo de la meta&quot;&#13;&#10;END' />
      </column>
      <column caption='Clientes Nuevos' datatype='integer' name='[Calculation_1295066421440057370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [fecha_registro] = {FIXED [cliente_id] : MIN([fecha_registro])} &#13;&#10;    THEN [cliente_id] &#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Meta Clientes' datatype='string' name='[Calculation_1295066421440639004]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_1295066421440057370] &gt; SUM([meta_nuevos_clientes])&#13;&#10;THEN &quot;Por encima de la meta&quot;&#13;&#10;ELSE &quot;Por debajo de la meta&quot;&#13;&#10;END' />
      </column>
