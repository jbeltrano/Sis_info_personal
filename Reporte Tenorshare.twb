          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dg0os21k9auo81eipedq0hwrpvv'>
            <column caption='Años Parametro' datatype='boolean' name='[Calculation_1216253428275777536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Todos&quot;&#13;&#10;THEN TRUE&#13;&#10;ELSE&#13;&#10;YEAR([fecha]) = INT([Parameters].[Parámetro 2])&#13;&#10;END' />
