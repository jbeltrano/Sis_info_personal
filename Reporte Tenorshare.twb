            </column>
            <column caption='Meta_ventas' datatype='string' name='[Calculation_1295066421434331154]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([cantidad]*[precio_unitario]) &gt; SUM([meta_ventas])&#13;&#10;THEN &quot;Por encima de la meta&quot;&#13;&#10;ELSE &quot;Por debajo de la meta&quot;&#13;&#10;END' />
            </column>
            <column caption='SUM([Precio Unitario]*[Cantidad])' datatype='integer' name='[Calculation_1295066421443166238]' role='measure' type='quantitative' user:unnamed='Comparacion Meta Ventas'>
              <calculation class='tableau' formula='SUM([precio_unitario]*[cantidad])' />
            </column>
