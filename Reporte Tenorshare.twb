            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dg0os21k9auo81eipedq0hwrpvv'>
            <column caption='Años Parametro' datatype='boolean' name='[Calculation_1216253428275777536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Todos&quot;&#13;&#10;THEN TRUE&#13;&#10;ELSE&#13;&#10;YEAR([fecha]) = INT([Parameters].[Parámetro 2])&#13;&#10;END' />
            </column>
            <column caption='Meses Parametro' datatype='boolean' name='[Calculation_1216253428276871169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] != &quot;Todos&quot;&#13;&#10;THEN&#13;&#10;    IF [Parameters].[Parámetro 3] = &quot;Todos&quot; THEN TRUE&#13;&#10;    ELSE MONTH([fecha])= INT([Parameters].[Parámetro 3])&#13;&#10;    END&#13;&#10;ELSE TRUE&#13;&#10;END' />
            </column>
            <column caption='Clientes Nuevos' datatype='integer' name='[Calculation_1295066421440057370]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD( &#13;&#10;    IF YEAR([fecha_registro]) = INT([Parameters].[Parámetro 2]) &#13;&#10;    THEN IF MONTH([fecha_registro]) = INT([Parameters].[Parámetro 3]) &#13;&#10;        THEN [cliente_id] &#13;&#10;        ELSEIF [Parameters].[Parámetro 3] = &quot;Todos&quot; &#13;&#10;            THEN [cliente_id] &#13;&#10;            END &#13;&#10;    ELSEIF [Parameters].[Parámetro 2] = &quot;Todos&quot; AND YEAR([fecha_registro])=YEAR([fecha])&#13;&#10;    THEN [cliente_id]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Meta Clientes' datatype='string' name='[Calculation_1295066421440639004]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  [Calculation_1295066421440057370] &gt; SUM([meta_nuevos_clientes])&#13;&#10;THEN &quot;Por encima de la meta&quot;&#13;&#10;ELSE &quot;Por debajo de la meta&quot;&#13;&#10;END' />
