              <calculation class='tableau' formula='&quot;2024&quot;' />
            </column>
            <column caption='Elge mes' datatype='string' datatype-customized='true' name='[Parámetro 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
